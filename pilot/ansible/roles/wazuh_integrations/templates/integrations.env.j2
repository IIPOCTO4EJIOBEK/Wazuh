# Настройки интеграций Wazuh. Управляется Ansible.
# Читается сценариями /var/ossec/integrations/custom-*.py
# Права 0640, владелец root:wazuh — здесь токены.

SDP_URL="{{ servicedesk_url }}"
SDP_AUTHTOKEN="{{ vault_servicedesk_authtoken }}"
SDP_TECHNICIAN_GROUP="{{ servicedesk_technician_group }}"
SDP_REQUEST_TEMPLATE="{{ servicedesk_request_template }}"
SDP_MIN_LEVEL="{{ alert_level_servicedesk }}"
SDP_VERIFY_TLS="no"

TELEGRAM_BOT_TOKEN="{{ vault_telegram_bot_token }}"
TELEGRAM_CHAT_ID="{{ vault_telegram_chat_id }}"
TELEGRAM_MIN_LEVEL="{{ alert_level_telegram }}"

ZABBIX_SERVER="{{ zabbix_server }}"
ZABBIX_HOST="{{ zabbix_sender_host }}"

DASHBOARD_URL="https://{{ wazuh_dashboard_fqdn }}"
CLUSTER_NAME="{{ manager_cluster_name }}"
