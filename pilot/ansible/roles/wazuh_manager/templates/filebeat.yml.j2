# =====================================================================
#  Filebeat: доставка alerts.json менеджера Wazuh в Wazuh Indexer.
#  Управляется Ansible.
# =====================================================================

filebeat.modules:
  - module: wazuh
    alerts:
      enabled: true
    archives:
      enabled: false

# Filebeat 7.10.2 (Go 1.14) падает на ядре >= 5.15 из-за своего seccomp-фильтра
# (pthread_create: Operation not permitted). Отключаем фильтр — фикс пилота.
seccomp.enabled: false

setup.template.json.enabled: true
setup.template.json.path: /etc/filebeat/wazuh-template.json
setup.template.json.name: wazuh
setup.ilm.enabled: false
setup.template.overwrite: true

output.elasticsearch:
  hosts:
{% for host in groups['wazuh_indexer'] %}
    - "https://{{ hostvars[host].ansible_host | default(host) }}:{{ indexer_http_port }}"
{% endfor %}
  username: "${username}"
  password: "${password}"
  ssl.certificate_authorities:
    - /etc/filebeat/certs/root-ca.pem
  ssl.certificate: /etc/filebeat/certs/manager.pem
  ssl.key: /etc/filebeat/certs/manager-key.pem
  ssl.verification_mode: full

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644
