# Настройки резервного копирования Wazuh. Управляется Ansible.
# Читается скриптами /usr/local/sbin/wazuh-backup.sh и wazuh-restore.sh

BACKUP_DIR="{{ config_backup_dir }}"
KEEP_DAYS="{{ config_backup_keep_days }}"
NODE_NAME="{{ manager_node_name | default(inventory_hostname) }}"
NODE_TYPE="{{ manager_node_type | default('worker') }}"

# Выгрузка за пределы площадки через уже настроенный в компании rclone
OFFSITE_ENABLED="{{ 'yes' if offsite_enabled else 'no' }}"
OFFSITE_REMOTE="{{ offsite_rclone_remote }}"

# Индексер: снапшоты делает сам OpenSearch по политике wazuh-daily,
# скрипт только проверяет, что последний снапшот свежий.
INDEXER_HOST="{{ groups['wazuh_indexer'][0] }}"
INDEXER_ADDR="{{ hostvars[groups['wazuh_indexer'][0]].ansible_host }}"
INDEXER_PORT="{{ indexer_http_port }}"
SNAPSHOT_REPO="{{ snapshot_repo_name }}"
INDEXER_USER="snapshotter"
INDEXER_PASS="{{ vault_indexer_snapshot_password }}"
