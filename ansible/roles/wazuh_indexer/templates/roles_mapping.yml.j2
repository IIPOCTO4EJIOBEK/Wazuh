---
# =====================================================================
#  Сопоставление ролей и учётных записей. Управляется Ansible.
# =====================================================================

_meta:
  type: "rolesmapping"
  config_version: 2

# Администраторы платформы. Список задан переменной indexer_admin_users
# в group_vars — правится в одном месте, а не в шаблоне.
all_access:
  reserved: true
  hidden: false
  backend_roles:
    - "admin"
  users:
{% for u in indexer_admin_users | default([]) %}
    - "{{ u }}"
{% endfor %}
  description: "Полный доступ"

own_index:
  reserved: false
  users:
    - "*"
  description: "Доступ к собственным индексам"

kibana_server:
  reserved: true
  hidden: false
  users:
    - "kibanaserver"

wazuh_writer:
  reserved: false
  users:
    - "filebeat"
  backend_roles:
    - "wazuh_writer"

wazuh_snapshot:
  reserved: false
  users:
    - "snapshotter"
  backend_roles:
    - "wazuh_snapshot"

# "*" — любой прошедший проверку подлинности, включая доменных
# пользователей. Роль даёт только чтение алертов и уязвимостей.
wazuh_reader:
  reserved: false
  users:
    - "auditor"
{% if indexer_readonly_for_all | default(true) %}
    - "*"
{% endif %}
  backend_roles:
    - "wazuh_reader"

# Просмотр дашбордов под ролью только для чтения
kibana_user:
  reserved: false
  users:
    - "auditor"
{% if indexer_readonly_for_all | default(true) %}
    - "*"
{% endif %}
  backend_roles:
    - "wazuh_reader"

security_rest_api_access:
  reserved: true
  users:
    - "admin"
